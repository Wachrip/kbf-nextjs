# Источник данных — обязательно, явно (без значения сайт не стартует, см. src/data/getSource.ts):
#   firestore — боевая база kbf-site через REST;
#   mock      — фикстуры без сети (или просто `pnpm dev:mock`).
KBF_DATA=

# Проект Firebase (читается REST без ключа; правила должны разрешать гостю чтение).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kbf-site

# Адрес сайта без слэша в конце: canonical, Open Graph, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# View Transitions (React <ViewTransition>): on — по умолчанию, off — выключить одной настройкой.
NEXT_PUBLIC_VIEW_TRANSITIONS=on
